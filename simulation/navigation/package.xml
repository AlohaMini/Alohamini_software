<?xml version="1.0"?>
<package format="3">
  <name>alohamini_nav_sim</name><version>0.1.0</version>
  <description>Planar EDU navigation simulation with geometric LiDAR and measured ROS feedback</description>
  <maintainer email="anncatto@users.noreply.github.com">AlohaMini</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>alohamini_navigation</exec_depend><exec_depend>alohamini_sensors</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>std_srvs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
