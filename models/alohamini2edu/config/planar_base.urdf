<?xml version='1.0' encoding='utf-8'?>
<robot name="planar_base">
  <!--Nonphysical X/Y/yaw wrapper; physical links always come from the canonical URDF.-->
  <link name="root">
    </link>
  <link name="root_x_link">
  </link>
  <link name="root_y_link">
  </link>
  <joint name="root_x_axis_joint" type="prismatic">
    <parent link="root" />
    <child link="root_x_link" />
    <axis xyz="1 0 0" />
    <limit effort="500" lower="-20" upper="20" velocity="1.0" />
    <dynamics damping="100.0" friction="10" />
  </joint>
  <joint name="root_y_axis_joint" type="prismatic">
    <parent link="root_x_link" />
    <child link="root_y_link" />
    <axis xyz="0 1 0" />
    <limit effort="500" lower="-20" upper="20" velocity="1.0" />
    <dynamics damping="100.0" friction="10" />
  </joint>
  <joint name="root_z_rotation_joint" type="revolute">
    <parent link="root_y_link" />
    <child link="base_link" />
    <axis xyz="0 0 1" />
    <limit effort="500" lower="-6.28" upper="6.28" velocity="1.0" />
    <dynamics damping="100.0" friction="10" />
  </joint>
</robot>
