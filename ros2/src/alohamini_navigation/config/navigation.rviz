Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 680
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 0.5
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: false
    Frame Timeout: 5
    Frames:
      All Enabled: true
    Marker Scale: 0.4
    Name: TF
    Show Arrows: false
    Show Axes: false
    Show Names: false
    Tree: {}
    Update Interval: 0.2
    Value: false
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Value: /alohamini/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Enabled: true
    Name: RobotModel
    Update Interval: 0.2
    Value: true
    Visual Enabled: true
  - Class: alohamini_rviz/Image
    Enabled: true
    Max Value: 1
    Median window: 1
    Min Value: 0
    Name: Head Camera
    Normalize Range: true
    Queue Size: 1
    Transport Hint: compressed
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /alohamini/cameras/forward/image_raw/compressed
    Value: true
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: false
    Enabled: true
    Name: Map
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Update Topic: /map_updates
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 80; 40
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: LaserScan
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.03
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan_filtered
    Use Fixed Frame: true
    Value: true
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: Scan Sector
    Namespaces:
      scan_sector: true
    Queue Size: 10
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan_sector_marker
  - Angle Tolerance: 0.1
    Class: rviz_default_plugins/Odometry
    Covariance:
      Orientation:
        Alpha: 0.5
        Color: 255; 255; 127
        Color Style: Unique
        Frame: Local
        Offset: 1
        Scale: 1
        Value: false
      Position:
        Alpha: 0.3
        Color: 204; 51; 204
        Scale: 1
        Value: false
      Value: false
    Enabled: false
    Keep: 1
    Name: Odometry
    Position Tolerance: 0.1
    Shape:
      Alpha: 1
      Axes Length: 0.3
      Axes Radius: 0.03
      Color: 0; 255; 0
      Head Length: 0.1
      Head Radius: 0.03
      Shaft Length: 0.2
      Shaft Radius: 0.01
      Value: Arrow
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /odom
    Value: false
  - Class: rviz_default_plugins/Path
    Color: 25; 255; 0
    Enabled: true
    Line Style: Lines
    Line Width: 0.03
    Name: Global Plan
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /plan
    Value: true
  - Alpha: 0.6
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: true
    Name: Global Costmap
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Update Topic: /global_costmap/costmap_updates
    Value: true
  - Alpha: 0.6
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: true
    Name: Local Costmap
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Update Topic: /local_costmap/costmap_updates
    Value: true
  - Class: rviz_default_plugins/Path
    Name: Local Plan
    Enabled: true
    Color: 255; 170; 0
    Line Width: 0.03
    Topic:
      Value: /local_plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.4
      Target Frame: <Fixed Frame>
      Yaw: 0.8
    Saved: null
Window Geometry:
  Width: 1360
  Height: 900
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Displays:
    collapsed: false
  Head Camera:
    collapsed: false
  Navigation 2:
    collapsed: false
  Views:
    collapsed: false
